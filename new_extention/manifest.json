{
  "manifest_version": 3,
  "name": "SentinelAI",
  "version": "1.0.0",
  "description": "SentinelAI security sensing agent",

  "permissions": [
    "management",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
  "https://myaccount.google.com/*",
  "https://chatgpt.com/*",
  "https://chat.openai.com/*",
  "https://claude.ai/*",
  "https://gemini.google.com/*",
  "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "<all_urls>"
],
  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinel"
  },

  "icons": {
    "128": "icon128.png"
  }
}